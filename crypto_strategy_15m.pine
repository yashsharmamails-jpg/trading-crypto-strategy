//@version=5
strategy("ICT Strategy Engine", 
     overlay=true, 
     default_qty_type=strategy.percent_of_equity, 
     default_qty_value=10,
     initial_capital=10000,
     commission_type=strategy.commission.percent,
     commission_value=0.06,
     slippage=2,
     pyramiding=0,
     calc_on_every_tick=false,
     process_orders_on_close=true,
     max_boxes_count=100,
     max_lines_count=100,
     max_labels_count=100,
     max_bars_back=5000)

// ══════════════════════════════════════════════════════════════
// INPUTS
// ══════════════════════════════════════════════════════════════

grpRisk = "Risk Management"
i_accountSize   = input.float(1000.0, "Account Size (USD)", minval=100, maxval=1000000, group=grpRisk)
i_riskPercent   = input.float(1.0, "Risk Per Trade (%)", minval=0.5, maxval=3.0, step=0.1, group=grpRisk)
i_maxLeverage   = input.int(10, "Max Leverage", minval=1, maxval=20, group=grpRisk)
i_atrMult       = input.float(1.0, "ATR Multiplier (Stop)", minval=0.5, maxval=3.0, step=0.1, group=grpRisk)
i_dailyLimit    = input.int(2, "Daily Signal Limit", minval=1, maxval=5, group=grpRisk)

grpFilter = "Filters"
i_htfFilter     = input.bool(true, "Enable HTF Trend Filter", group=grpFilter)
i_sessionFilter = input.bool(true, "Enable Session Filter", group=grpFilter)
i_newsFilter    = input.bool(false, "Block Signals Before News?", group=grpFilter)

grpAdv = "Advanced"
i_obImpulse     = input.float(1.0, "OB Impulse Threshold (ATR x)", minval=0.5, maxval=2.0, step=0.1, group=grpAdv)
i_pivotBars     = input.int(2, "Swing Pivot Bars", minval=2, maxval=5, group=grpAdv)

grpVis = "Position Tool"
i_showPosTool   = input.bool(true, "Show Position Tool Boxes", group=grpVis)

// ══════════════════════════════════════════════════════════════
// CORE CALCULATIONS
// ══════════════════════════════════════════════════════════════

float atr14 = ta.atr(14)
float rsi14 = ta.rsi(close, 14)
float ema21 = ta.ema(close, 21)
float ema50 = ta.ema(close, 50)

htfTF = timeframe.period == "15" ? "60" : "240"
[htf_ema21, htf_ema50] = request.security(syminfo.tickerid, htfTF, [ta.ema(close, 21), ta.ema(close, 50)], barmerge.gaps_off, barmerge.lookahead_off)

utcHour = hour(time, "UTC")
inLondon = utcHour >= 7 and utcHour < 10
inNewYork = utcHour >= 13 and utcHour < 16
inAsian = utcHour >= 0 and utcHour < 8
sessionActive = inLondon or inNewYork

f_isConfirmedBar() => barstate.isconfirmed
f_bodySize() => math.abs(close - open)
f_candleRange() => high - low

f_isBullishEngulfing() =>
    body = f_bodySize()
    rng = f_candleRange()
    rng > 0 and close > open[1] and body > 0.6 * rng and close > high - 0.3 * rng and close > open

f_isHammer() =>
    body = f_bodySize()
    lw = close > open ? open - low : close - low
    rng = f_candleRange()
    rng > 0 and lw > 2.0 * body and close > (high + low) / 2 and close > open

f_isBearishEngulfing() =>
    body = f_bodySize()
    rng = f_candleRange()
    rng > 0 and close < open[1] and body > 0.6 * rng and close < low + 0.3 * rng and close < open

f_isShootingStar() =>
    body = f_bodySize()
    uw = close > open ? high - close : high - open
    rng = f_candleRange()
    rng > 0 and uw > 2.0 * body and close < (high + low) / 2 and close < open

var int signalsToday = 0
var int lastResetDay = 0
currentDay = dayofmonth(time, "UTC")
if currentDay != lastResetDay
    signalsToday := 0
    lastResetDay := currentDay

// ══════════════════════════════════════════════════════════════
// MARKET STRUCTURE
// ══════════════════════════════════════════════════════════════

swingHigh = ta.pivothigh(high, i_pivotBars, i_pivotBars)
swingLow  = ta.pivotlow(low, i_pivotBars, i_pivotBars)

var float sh_1 = na, var float sh_2 = na
var float sl_1 = na, var float sl_2 = na
var int sh_1_bar = na, var int sl_1_bar = na

if not na(swingHigh)
    sh_2 := sh_1
    sh_1 := swingHigh
    sh_1_bar := bar_index - i_pivotBars

if not na(swingLow)
    sl_2 := sl_1
    sl_1 := swingLow
    sl_1_bar := bar_index - i_pivotBars

var int structureBias = 0
var int prevStructureBias = 0

bool hasHH = not na(sh_1) and not na(sh_2) and sh_1 > sh_2
bool hasHL = not na(sl_1) and not na(sl_2) and sl_1 > sl_2
bool hasLH = not na(sh_1) and not na(sh_2) and sh_1 < sh_2
bool hasLL = not na(sl_1) and not na(sl_2) and sl_1 < sl_2

int newBias = hasHH and hasHL ? 1 : hasLH and hasLL ? -1 : 0
if newBias != structureBias and newBias != 0
    prevStructureBias := structureBias
    structureBias := newBias

var bool bosUp = false, var bool bosDn = false
var bool chochUp = false, var bool chochDn = false
var float bosLevel = na, var float chochLevel = na
var int bullCount = 0, var int bearCount = 0

if not na(swingHigh)
    if hasHH
        bullCount += 1
        bearCount := 0
    if hasLH
        bearCount += 1
        bullCount := 0
if not na(swingLow)
    if hasHL
        bullCount += 1
        bearCount := 0
    if hasLL
        bearCount += 1
        bullCount := 0

bosUp := false
bosDn := false
chochUp := false
chochDn := false

if f_isConfirmedBar() and not na(sh_1) and close > sh_1
    if prevStructureBias == -1 and bearCount >= 2 and structureBias != 1
        chochUp := true
        chochLevel := sh_1
    else if structureBias == 1 or structureBias == 0
        bosUp := true
        bosLevel := sh_1

if f_isConfirmedBar() and not na(sl_1) and close < sl_1
    if prevStructureBias == 1 and bullCount >= 2 and structureBias != -1
        chochDn := true
        chochLevel := sl_1
    else if structureBias == -1 or structureBias == 0
        bosDn := true
        bosLevel := sl_1

var bool hasBullBOS = false, var bool hasBearBOS = false
if bosUp or chochUp
    hasBullBOS := true
    hasBearBOS := false
if bosDn or chochDn
    hasBearBOS := true
    hasBullBOS := false

// ══════════════════════════════════════════════════════════════
// LIQUIDITY SWEEP (simplified — no drawings)
// ══════════════════════════════════════════════════════════════

var float pdh = na, var float pdl = na
var float currDayHigh = na, var float currDayLow = na
newDay = ta.change(time("D")) != 0
if newDay
    pdh := currDayHigh
    pdl := currDayLow
    currDayHigh := high
    currDayLow := low
else
    currDayHigh := math.max(nz(currDayHigh, high), high)
    currDayLow := math.min(nz(currDayLow, low), low)

var bool asianComplete = false
var float asianHigh = na, var float asianLow = na
bool isAsianHour = utcHour >= 0 and utcHour < 8
bool wasAsianHour = hour(time[1], "UTC") >= 0 and hour(time[1], "UTC") < 8
if isAsianHour and not wasAsianHour
    asianHigh := high
    asianLow := low
    asianComplete := false
if isAsianHour
    asianHigh := math.max(nz(asianHigh, high), high)
    asianLow := math.min(nz(asianLow, low), low)
if not isAsianHour and wasAsianHour and not asianComplete
    asianComplete := true

var bool bullSweep = false, var float bullSweepLevel = na
var bool bearSweep = false, var float bearSweepLevel = na
bullSweep := false
bearSweep := false

if not na(sl_1) and low < sl_1 and close > sl_1 and (bar_index - nz(sl_1_bar, 0)) < 50
    bullSweep := true
    bullSweepLevel := sl_1
if not bullSweep and asianComplete and not na(asianLow) and low < asianLow and close > asianLow
    bullSweep := true
    bullSweepLevel := asianLow

if not na(sh_1) and high > sh_1 and close < sh_1 and (bar_index - nz(sh_1_bar, 0)) < 50
    bearSweep := true
    bearSweepLevel := sh_1
if not bearSweep and asianComplete and not na(asianHigh) and high > asianHigh and close < asianHigh
    bearSweep := true
    bearSweepLevel := asianHigh

// ══════════════════════════════════════════════════════════════
// ORDER BLOCK DETECTION (simplified — no drawings)
// ══════════════════════════════════════════════════════════════

var bool inBullOB = false, var float obBot_l = na
var bool inBearOB = false, var float obTop_s = na

// Bullish OB: after BOS up, find last bearish candle
if (bosUp or chochUp) and f_isConfirmedBar()
    float impulseBody = math.abs(close - open)
    if impulseBody >= i_obImpulse * atr14
        for i = 1 to 10
            if close[i] < open[i]
                obBot_l := low[i]
                break

// Bearish OB: after BOS down, find last bullish candle
if (bosDn or chochDn) and f_isConfirmedBar()
    float impulseBody = math.abs(close - open)
    if impulseBody >= i_obImpulse * atr14
        for i = 1 to 10
            if close[i] > open[i]
                obTop_s := high[i]
                break

// Check if price is in OB zone (simplified)
inBullOB := not na(obBot_l) and low <= nz(obBot_l, 0) + atr14 and close >= obBot_l
inBearOB := not na(obTop_s) and high >= nz(obTop_s, 99999999) - atr14 and close <= obTop_s

// ══════════════════════════════════════════════════════════════
// SIGNAL CONFLUENCE ENGINE
// ══════════════════════════════════════════════════════════════

bool longSignal = false
bool shortSignal = false
var float slPrice = na
var float tp2Price = na

// LONG
if f_isConfirmedBar() and strategy.position_size == 0
    bool c1 = structureBias == 1
    bool c2 = inBullOB or bullSweep
    bool c3 = bullSweep
    bool c4 = rsi14 < 45 and ema21 > ema50
    bool c5 = f_isBullishEngulfing() or f_isHammer()
    bool c6 = i_sessionFilter ? sessionActive : true
    bool c7 = i_htfFilter ? (htf_ema21 > htf_ema50) : true

    if c1 and c2 and c3 and c4 and c5 and c6 and c7
        if hasBullBOS and rsi14 <= 70 and not i_newsFilter and signalsToday < i_dailyLimit
            float sl_raw = math.min(nz(obBot_l, low), nz(bullSweepLevel, low)) - (syminfo.mintick * 5)
            float atr_floor = close - (0.8 * atr14)
            float sl_calc = sl_raw > atr_floor ? atr_floor : sl_raw
            float atr_ceiling = close - (2.0 * atr14 * i_atrMult)
            if sl_raw >= atr_ceiling
                float stopDist = math.abs(close - sl_calc)
                float stopPct = stopDist / close * 100
                if stopPct >= 0.4
                    float tp2_calc = close + (stopDist * 2.0)
                    float riskAmt = i_accountSize * (i_riskPercent / 100)
                    float levReq = (riskAmt / stopDist * close) / i_accountSize
                    if levReq <= i_maxLeverage
                        longSignal := true
                        slPrice := sl_calc
                        tp2Price := tp2_calc
                        signalsToday += 1

// SHORT
if f_isConfirmedBar() and strategy.position_size == 0
    bool c1s = structureBias == -1
    bool c2s = inBearOB or bearSweep
    bool c3s = bearSweep
    bool c4s = rsi14 > 55 and ema21 < ema50
    bool c5s = f_isBearishEngulfing() or f_isShootingStar()
    bool c6s = i_sessionFilter ? sessionActive : true
    bool c7s = i_htfFilter ? (htf_ema21 < htf_ema50) : true

    if c1s and c2s and c3s and c4s and c5s and c6s and c7s
        if hasBearBOS and rsi14 >= 30 and not i_newsFilter and signalsToday < i_dailyLimit
            float sl_raw_s = math.max(nz(obTop_s, high), nz(bearSweepLevel, high)) + (syminfo.mintick * 5)
            float atr_floor_s = close + (0.8 * atr14)
            float sl_calc_s = sl_raw_s < atr_floor_s ? atr_floor_s : sl_raw_s
            float atr_ceiling_s = close + (2.0 * atr14 * i_atrMult)
            if sl_raw_s <= atr_ceiling_s
                float stopDist_s = math.abs(sl_calc_s - close)
                float stopPct_s = stopDist_s / close * 100
                if stopPct_s >= 0.4
                    float tp2_s = close - (stopDist_s * 2.0)
                    float riskAmt_s = i_accountSize * (i_riskPercent / 100)
                    float levReq_s = (riskAmt_s / stopDist_s * close) / i_accountSize
                    if levReq_s <= i_maxLeverage
                        shortSignal := true
                        slPrice := sl_calc_s
                        tp2Price := tp2_s
                        signalsToday += 1

// ══════════════════════════════════════════════════════════════
// STRATEGY ENTRIES & EXITS
// ══════════════════════════════════════════════════════════════

if longSignal
    strategy.entry("Long", strategy.long)

if shortSignal
    strategy.entry("Short", strategy.short)

if strategy.position_size > 0
    strategy.exit("L-Exit", from_entry="Long", stop=slPrice, limit=tp2Price)

if strategy.position_size < 0
    strategy.exit("S-Exit", from_entry="Short", stop=slPrice, limit=tp2Price)

// ══════════════════════════════════════════════════════════════
// POSITION TOOL (Green TP box, Red SL box, Blue entry line)
// ══════════════════════════════════════════════════════════════

var box   tpBox    = na
var box   slBox    = na
var line  entryLn  = na
var label entryLbl = na
var label slLbl    = na
var label tpLbl    = na

// Draw on entry
if longSignal and i_showPosTool
    box.delete(tpBox)
    box.delete(slBox)
    line.delete(entryLn)
    label.delete(entryLbl)
    label.delete(slLbl)
    label.delete(tpLbl)
    int rightBar = bar_index + 60
    tpBox   := box.new(bar_index, tp2Price,  rightBar, close,   bgcolor=color.new(color.green, 80), border_color=color.new(color.green, 30), border_width=1)
    slBox   := box.new(bar_index, close,     rightBar, slPrice, bgcolor=color.new(color.red, 80),   border_color=color.new(color.red, 30),   border_width=1)
    entryLn := line.new(bar_index, close, rightBar, close, color=color.new(color.blue, 0), width=2, style=line.style_solid)
    entryLbl := label.new(rightBar, close,    "ENTRY " + str.tostring(close, format.mintick), style=label.style_label_left, color=color.new(color.blue, 0), textcolor=color.white, size=size.small)
    slLbl    := label.new(rightBar, slPrice,  "SL " + str.tostring(slPrice, format.mintick), style=label.style_label_left, color=color.new(color.red, 0), textcolor=color.white, size=size.small)
    tpLbl    := label.new(rightBar, tp2Price, "TP " + str.tostring(tp2Price, format.mintick), style=label.style_label_left, color=color.new(color.green, 0), textcolor=color.white, size=size.small)

if shortSignal and i_showPosTool
    box.delete(tpBox)
    box.delete(slBox)
    line.delete(entryLn)
    label.delete(entryLbl)
    label.delete(slLbl)
    label.delete(tpLbl)
    int rightBar = bar_index + 60
    tpBox   := box.new(bar_index, close,    rightBar, tp2Price, bgcolor=color.new(color.green, 80), border_color=color.new(color.green, 30), border_width=1)
    slBox   := box.new(bar_index, slPrice,  rightBar, close,    bgcolor=color.new(color.red, 80),   border_color=color.new(color.red, 30),   border_width=1)
    entryLn := line.new(bar_index, close, rightBar, close, color=color.new(color.blue, 0), width=2, style=line.style_solid)
    entryLbl := label.new(rightBar, close,    "ENTRY " + str.tostring(close, format.mintick), style=label.style_label_left, color=color.new(color.blue, 0), textcolor=color.white, size=size.small)
    slLbl    := label.new(rightBar, slPrice,  "SL " + str.tostring(slPrice, format.mintick), style=label.style_label_left, color=color.new(color.red, 0), textcolor=color.white, size=size.small)
    tpLbl    := label.new(rightBar, tp2Price, "TP " + str.tostring(tp2Price, format.mintick), style=label.style_label_left, color=color.new(color.green, 0), textcolor=color.white, size=size.small)

// Extend boxes while in trade
if strategy.position_size != 0 and not na(tpBox)
    int nr = bar_index + 5
    box.set_right(tpBox, nr)
    box.set_right(slBox, nr)
    line.set_x2(entryLn, nr)
    if not na(entryLbl)
        label.set_x(entryLbl, nr)
        label.set_x(slLbl, nr)
        label.set_x(tpLbl, nr)

// ══════════════════════════════════════════════════════════════
// END — Clean chart. No arrows. No plotshapes. Just position tool.
// Add the ICT indicator to same chart for OBs/FVGs/structure/liquidity.
// ══════════════════════════════════════════════════════════════
