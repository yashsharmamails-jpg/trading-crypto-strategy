//@version=5
strategy("Liquidity Sweep A+ Strategy v4", 
     overlay=true, 
     default_qty_type=strategy.percent_of_equity, 
     default_qty_value=10,
     initial_capital=10000,
     commission_type=strategy.commission.percent,
     commission_value=0.06,
     slippage=2,
     pyramiding=0,
     calc_on_every_tick=false,
     process_orders_on_close=true,
     max_boxes_count=200,
     max_lines_count=200,
     max_labels_count=200)

// ══════════════════════════════════════════════════════════════════════════════
// ░░░ INPUTS ░░░
// ══════════════════════════════════════════════════════════════════════════════

// --- Pivot / S/R Zone Settings ---
pivotLen     = input.int(10, "Pivot Lookback (bars)", minval=3, group="Support/Resistance",
     tooltip="Larger = stronger but less frequent zones. 10 is balanced for 15m.")
maxZones     = input.int(4, "Max Active Zones (each side)", minval=1, maxval=10, group="Support/Resistance")
zoneThicknessAtr = input.float(0.20, "Zone Thickness (x ATR)", minval=0.05, step=0.05, group="Support/Resistance")
minLevelAge  = input.int(8, "Min Level Age (bars) for A+", minval=3, group="Support/Resistance",
     tooltip="A swept level must be at least this old. Older levels = stronger liquidity.")

// --- A+ Quality Filters ---
useWickFilter = input.bool(true,  "Strong Rejection Wick (A+)", group="A+ Filters")
wickPct       = input.float(0.55, "Min Rejection Wick %", minval=0.30, maxval=0.85, step=0.05, group="A+ Filters",
     tooltip="Rejection wick must be at least this % of candle range. 0.55 = strong rejection.")
useVolFilter  = input.bool(true,  "Volume Spike on Sweep (A+)", group="A+ Filters")
volMult       = input.float(1.3,  "Min Volume vs 20-MA", minval=1.0, step=0.1, group="A+ Filters")
useHtfBias    = input.bool(true,  "HTF Bias Filter (A+)", group="A+ Filters",
     tooltip="Only trade in direction of HTF momentum (no EMA used — pure price comparison)")
htfTF         = input.timeframe("240", "Higher Timeframe", options=["60","120","240","D"], group="A+ Filters")
htfLookback   = input.int(20, "HTF Momentum Lookback (bars)", minval=5, group="A+ Filters")

// --- Risk:Reward ---
rrChoice = input.string("1:2", "Risk:Reward", options=["1:1.5","1:2","1:3"], group="Risk:Reward")
rrMult   = rrChoice == "1:3" ? 3.0 : rrChoice == "1:2" ? 2.0 : 1.5

// --- Stop Loss Buffer ---
slBufferAtr = input.float(0.25, "SL Buffer beyond Sweep Wick (x ATR)", minval=0.0, step=0.05, group="Stop Loss",
     tooltip="Extra room beyond the sweep wick to avoid stop hunts.")

// --- Trade Direction ---
tradeLong  = input.bool(true, "Allow Long Trades",  group="Trade Direction")
tradeShort = input.bool(true, "Allow Short Trades", group="Trade Direction")

// --- Cooldown ---
cooldownBars = input.int(10, "Cooldown Between Trades (bars)", minval=0, group="Cooldown")

// --- Visuals ---
showZones      = input.bool(true,  "Show S/R Zones",            group="Visuals")
showSweepMarks = input.bool(true,  "Show Liquidity Sweep Marks", group="Visuals")
showPositionTool = input.bool(true, "Show Position Tool Boxes",  group="Visuals")
showInfoTable  = input.bool(true,  "Show Info Table",            group="Visuals")

// --- Backtest Range ---
startDate = input.time(timestamp("01 Nov 2025 00:00 +0000"), "Backtest Start", group="Backtest Range")
endDate   = input.time(timestamp("01 Jun 2026 00:00 +0000"), "Backtest End",   group="Backtest Range")
inDateRange = time >= startDate and time <= endDate

// ══════════════════════════════════════════════════════════════════════════════
// ░░░ CORE CALCULATIONS ░░░
// ══════════════════════════════════════════════════════════════════════════════

atr   = ta.atr(14)
volMA = ta.sma(volume, 20)

// --- HTF Momentum Bias (no EMA — pure price comparison) ---
htfClose     = request.security(syminfo.tickerid, htfTF, close[1], lookahead=barmerge.lookahead_off)
htfClosePast = request.security(syminfo.tickerid, htfTF, close[1][htfLookback], lookahead=barmerge.lookahead_off)
htfBull = htfClose > htfClosePast
htfBear = htfClose < htfClosePast

// --- Pivot detection (defines swing highs/lows = liquidity pools) ---
ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow(low,  pivotLen, pivotLen)

// ══════════════════════════════════════════════════════════════════════════════
// ░░░ MANAGE S/R ZONES (boxes) ░░░
// ══════════════════════════════════════════════════════════════════════════════

var array<float> resLevels   = array.new<float>()
var array<int>   resBars     = array.new<int>()
var array<box>   resBoxes    = array.new<box>()

var array<float> supLevels   = array.new<float>()
var array<int>   supBars     = array.new<int>()
var array<box>   supBoxes    = array.new<box>()

// Add new resistance zone when pivot high confirmed
if not na(ph)
    pivotBar = bar_index - pivotLen
    array.push(resLevels, ph)
    array.push(resBars,   pivotBar)
    if showZones
        zoneTop = ph + atr * zoneThicknessAtr * 0.5
        zoneBot = ph - atr * zoneThicknessAtr * 0.5
        newBox = box.new(pivotBar, zoneTop, bar_index, zoneBot,
                 bgcolor=color.new(color.red, 88),
                 border_color=color.new(color.red, 60),
                 border_width=1,
                 extend=extend.right)
        array.push(resBoxes, newBox)
    // Trim oldest if exceeds max
    while array.size(resLevels) > maxZones
        array.shift(resLevels)
        array.shift(resBars)
        if showZones and array.size(resBoxes) > 0
            box.delete(array.shift(resBoxes))

// Add new support zone when pivot low confirmed
if not na(pl)
    pivotBar = bar_index - pivotLen
    array.push(supLevels, pl)
    array.push(supBars,   pivotBar)
    if showZones
        zoneTop = pl + atr * zoneThicknessAtr * 0.5
        zoneBot = pl - atr * zoneThicknessAtr * 0.5
        newBox = box.new(pivotBar, zoneTop, bar_index, zoneBot,
                 bgcolor=color.new(color.green, 88),
                 border_color=color.new(color.green, 60),
                 border_width=1,
                 extend=extend.right)
        array.push(supBoxes, newBox)
    while array.size(supLevels) > maxZones
        array.shift(supLevels)
        array.shift(supBars)
        if showZones and array.size(supBoxes) > 0
            box.delete(array.shift(supBoxes))

// ══════════════════════════════════════════════════════════════════════════════
// ░░░ LIQUIDITY SWEEP DETECTION ░░░
// ══════════════════════════════════════════════════════════════════════════════

// Find the most recent qualifying resistance level (old enough)
findActiveRes() =>
    float lvl = na
    int   ageOk = 0
    if array.size(resLevels) > 0
        for i = array.size(resLevels) - 1 to 0
            l = array.get(resLevels, i)
            b = array.get(resBars, i)
            if (bar_index - b) >= minLevelAge
                lvl := l
                break
    lvl

findActiveSup() =>
    float lvl = na
    if array.size(supLevels) > 0
        for i = array.size(supLevels) - 1 to 0
            l = array.get(supLevels, i)
            b = array.get(supBars, i)
            if (bar_index - b) >= minLevelAge
                lvl := l
                break
    lvl

activeRes = findActiveRes()
activeSup = findActiveSup()

// Bearish sweep = wick above resistance, close back below it
bearishSweep = not na(activeRes) and high > activeRes and close < activeRes

// Bullish sweep = wick below support, close back above it
bullishSweep = not na(activeSup) and low < activeSup and close > activeSup

// --- Strong rejection wick filter ---
candleRange = high - low
upperWick = high - math.max(close, open)
lowerWick = math.min(close, open) - low
strongUpperRejection = candleRange > 0 and (upperWick / candleRange) >= wickPct
strongLowerRejection = candleRange > 0 and (lowerWick / candleRange) >= wickPct

// --- Volume spike filter ---
volSpike = volume > volMA * volMult

// --- Cooldown ---
var int barsSinceExit = 1000
if strategy.position_size != 0
    barsSinceExit := 0
else
    barsSinceExit := barsSinceExit + 1
cooldownOk = barsSinceExit > cooldownBars

// ══════════════════════════════════════════════════════════════════════════════
// ░░░ A+ ENTRY CONDITIONS ░░░
// ══════════════════════════════════════════════════════════════════════════════

shortAplus = bearishSweep and 
     (not useWickFilter or strongUpperRejection) and 
     (not useVolFilter or volSpike) and 
     (not useHtfBias or htfBear) and 
     cooldownOk and 
     inDateRange and 
     tradeShort and 
     strategy.position_size == 0

longAplus = bullishSweep and 
     (not useWickFilter or strongLowerRejection) and 
     (not useVolFilter or volSpike) and 
     (not useHtfBias or htfBull) and 
     cooldownOk and 
     inDateRange and 
     tradeLong and 
     strategy.position_size == 0

// ══════════════════════════════════════════════════════════════════════════════
// ░░░ POSITION TOOL DRAWING ░░░
// ══════════════════════════════════════════════════════════════════════════════

var float entryPrice = na
var float slPrice    = na
var float tpPrice    = na
var int   entryBar   = na
var bool  isLong     = false

var box   tpBox    = na
var box   slBox    = na
var line  entryLn  = na
var label tradeLbl = na

clearPositionTool() =>
    if not na(tpBox)
        box.delete(tpBox)
    if not na(slBox)
        box.delete(slBox)
    if not na(entryLn)
        line.delete(entryLn)
    if not na(tradeLbl)
        label.delete(tradeLbl)

drawPositionTool(bool _isLong, float _entry, float _sl, float _tp) =>
    if showPositionTool
        rightBar = bar_index + 30
        if _isLong
            tpBox    := box.new(bar_index, _tp,    rightBar, _entry, bgcolor=color.new(color.green, 80), border_color=color.new(color.green, 30), border_width=1)
            slBox    := box.new(bar_index, _entry, rightBar, _sl,    bgcolor=color.new(color.red,   80), border_color=color.new(color.red,   30), border_width=1)
        else
            tpBox    := box.new(bar_index, _entry, rightBar, _tp,    bgcolor=color.new(color.green, 80), border_color=color.new(color.green, 30), border_width=1)
            slBox    := box.new(bar_index, _sl,    rightBar, _entry, bgcolor=color.new(color.red,   80), border_color=color.new(color.red,   30), border_width=1)
        entryLn := line.new(bar_index, _entry, rightBar, _entry, color=color.new(color.blue, 0), width=1, style=line.style_dashed)
        labelText = (_isLong ? "LONG" : "SHORT") + " @ " + str.tostring(_entry, format.mintick) + 
             "\nSL: " + str.tostring(_sl, format.mintick) + 
             "\nTP: " + str.tostring(_tp, format.mintick) + 
             "\nR:R " + rrChoice
        tradeLbl := label.new(bar_index, _entry, labelText, 
             style=_isLong ? label.style_label_lower_left : label.style_label_upper_left, 
             color=color.new(color.blue, 0), 
             textcolor=color.white, 
             size=size.small)

// ══════════════════════════════════════════════════════════════════════════════
// ░░░ EXECUTE TRADES ░░░
// ══════════════════════════════════════════════════════════════════════════════

if longAplus
    sweepLow = low
    slPrice    := sweepLow - atr * slBufferAtr
    slDist     = close - slPrice
    tpPrice    := close + slDist * rrMult
    entryPrice := close
    entryBar   := bar_index
    isLong     := true
    clearPositionTool()
    drawPositionTool(true, entryPrice, slPrice, tpPrice)
    strategy.entry("Long", strategy.long)

if shortAplus
    sweepHigh = high
    slPrice    := sweepHigh + atr * slBufferAtr
    slDist     = slPrice - close
    tpPrice    := close - slDist * rrMult
    entryPrice := close
    entryBar   := bar_index
    isLong     := false
    clearPositionTool()
    drawPositionTool(false, entryPrice, slPrice, tpPrice)
    strategy.entry("Short", strategy.short)

if strategy.position_size > 0
    strategy.exit("L-Exit", from_entry="Long",  stop=slPrice, limit=tpPrice)

if strategy.position_size < 0
    strategy.exit("S-Exit", from_entry="Short", stop=slPrice, limit=tpPrice)

// --- Extend position tool right edge each bar while in trade ---
if strategy.position_size != 0 and not na(tpBox)
    box.set_right(tpBox, bar_index + 1)
    box.set_right(slBox, bar_index + 1)
    line.set_x2(entryLn, bar_index + 1)

// ══════════════════════════════════════════════════════════════════════════════
// ░░░ SWEEP MARKERS (small, clean) ░░░
// ══════════════════════════════════════════════════════════════════════════════

plotshape(showSweepMarks and shortAplus, "Bear Sweep", shape.labeldown, location.abovebar, 
     color=color.new(color.red, 0), textcolor=color.white, text="SWEEP", size=size.tiny)
plotshape(showSweepMarks and longAplus, "Bull Sweep", shape.labelup, location.belowbar, 
     color=color.new(color.green, 0), textcolor=color.white, text="SWEEP", size=size.tiny)

// ══════════════════════════════════════════════════════════════════════════════
// ░░░ INFO TABLE ░░░
// ══════════════════════════════════════════════════════════════════════════════

var table tbl = table.new(position.top_right, 2, 8, 
     bgcolor=color.new(color.black, 75), 
     border_width=1, border_color=color.gray)

if barstate.islast and showInfoTable
    table.cell(tbl, 0, 0, "LIQUIDITY SWEEP A+", text_color=color.yellow, text_size=size.small, bgcolor=color.new(color.navy, 50))
    table.cell(tbl, 1, 0, syminfo.ticker,         text_color=color.yellow, text_size=size.small, bgcolor=color.new(color.navy, 50))

    htfLbl = htfTF == "60" ? "1H" : htfTF == "120" ? "2H" : htfTF == "240" ? "4H" : htfTF
    table.cell(tbl, 0, 1, htfLbl + " Bias", text_color=color.white, text_size=size.small)
    table.cell(tbl, 1, 1, htfBull ? "BULL" : htfBear ? "BEAR" : "FLAT",
         text_color=htfBull ? color.green : htfBear ? color.red : color.gray, text_size=size.small)

    table.cell(tbl, 0, 2, "Active Resistance", text_color=color.white, text_size=size.small)
    table.cell(tbl, 1, 2, na(activeRes) ? "—" : str.tostring(activeRes, format.mintick),
         text_color=color.red, text_size=size.small)

    table.cell(tbl, 0, 3, "Active Support", text_color=color.white, text_size=size.small)
    table.cell(tbl, 1, 3, na(activeSup) ? "—" : str.tostring(activeSup, format.mintick),
         text_color=color.green, text_size=size.small)

    sigText = strategy.position_size > 0 ? "IN LONG" : strategy.position_size < 0 ? "IN SHORT" : "WAITING"
    sigCol  = strategy.position_size > 0 ? color.green : strategy.position_size < 0 ? color.red : color.gray
    table.cell(tbl, 0, 4, "Status", text_color=color.white, text_size=size.small)
    table.cell(tbl, 1, 4, sigText, text_color=sigCol, text_size=size.small)

    table.cell(tbl, 0, 5, "R:R", text_color=color.white, text_size=size.small)
    table.cell(tbl, 1, 5, rrChoice, text_color=color.aqua, text_size=size.small)

    table.cell(tbl, 0, 6, "Net Profit", text_color=color.white, text_size=size.small)
    table.cell(tbl, 1, 6, str.tostring(strategy.netprofit, "#.##"),
         text_color=strategy.netprofit > 0 ? color.green : color.red, text_size=size.small)

    winRate = strategy.closedtrades > 0 ? (strategy.wintrades / strategy.closedtrades) * 100 : 0
    pf = strategy.grossloss != 0 ? math.abs(strategy.grossprofit / strategy.grossloss) : 0
    table.cell(tbl, 0, 7, "Win% / PF / N", text_color=color.white, text_size=size.small)
    table.cell(tbl, 1, 7, str.tostring(winRate, "#.#") + "% / " + str.tostring(pf, "#.##") + " / " + str.tostring(strategy.closedtrades),
         text_color=color.white, text_size=size.small)

// ══════════════════════════════════════════════════════════════════════════════
// ░░░ ALERTS ░░░
// ══════════════════════════════════════════════════════════════════════════════

alertcondition(longAplus,  "A+ Long Sweep",  "A+ LONG: {{ticker}} swept support, bullish reversal @ {{close}}")
alertcondition(shortAplus, "A+ Short Sweep", "A+ SHORT: {{ticker}} swept resistance, bearish reversal @ {{close}}")
